<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>uplink.NET.new</AssemblyName>
    <RootNamespace>uplink.NET</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>TopperDEL</Authors>
    <Description>.NET 10+ wrapper around the storj/uplink-c library for accessing the Storj decentralized cloud storage network.</Description>
    <PackageTags>storj uplink decentralized cloud storage</PackageTags>
    <PackageProjectUrl>https://github.com/TopperDEL/uplink.NET.New</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/TopperDEL/uplink.NET.New</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <StorjUplinkVersion Condition="'$(StorjUplinkVersion)' == '' and '$(UPLINK_C_REF)' != ''">$(UPLINK_C_REF)</StorjUplinkVersion>
    <StorjUplinkVersion Condition="'$(StorjUplinkVersion)' == ''">v1.10.1</StorjUplinkVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Include native runtimes in NuGet package -->
    <Content Include="runtimes\**" Pack="true" PackagePath="runtimes\" Condition="Exists('runtimes\')" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
  </ItemGroup>
  <!--
    Analyzer-only packages. PrivateAssets="all" keeps them out of the
    consumer's transitive dependency graph - they only run at our build time.

    These were chosen because the suspected "Test host process crashed"
    failures look like Access / ProjectLease lifecycle bugs:
      - IDisposableAnalyzers covers Dispose-pattern correctness, finalizer
        races, missing using, leaked handles. Targets exactly the surface
        area we're investigating.
      - Microsoft.VisualStudio.Threading.Analyzers flags blocking awaits,
        sync-over-async, lock-during-await, and similar concurrency mistakes
        that show up in the Access lifetime sync code paths.
  -->
  <ItemGroup>
    <PackageReference Include="IDisposableAnalyzers" Version="4.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.13.61">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StorjUplinkVersion</_Parameter1>
      <_Parameter2>$(StorjUplinkVersion)</_Parameter2>
    </AssemblyAttribute>
    <!--
      Let the integration test project see the P/Invoke struct definitions
      in UplinkInterop so it can validate their layouts against the native
      C headers via Marshal.SizeOf / Marshal.OffsetOf.
    -->
    <InternalsVisibleTo Include="uplink.NET.IntegrationTests" />
  </ItemGroup>
</Project>
