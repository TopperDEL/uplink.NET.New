<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>uplink.NET.new</AssemblyName>
    <RootNamespace>uplink.NET</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>TopperDEL</Authors>
    <Description>.NET 10+ wrapper around the storj/uplink-c library for accessing the Storj decentralized cloud storage network.</Description>
    <PackageTags>storj uplink decentralized cloud storage</PackageTags>
    <PackageProjectUrl>https://github.com/TopperDEL/uplink.NET.New</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/TopperDEL/uplink.NET.New</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <StorjUplinkVersion Condition="'$(StorjUplinkVersion)' == '' and '$(UPLINK_C_REF)' != ''">$(UPLINK_C_REF)</StorjUplinkVersion>
    <StorjUplinkVersion Condition="'$(StorjUplinkVersion)' == ''">v1.10.1</StorjUplinkVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Include native runtimes in NuGet package -->
    <Content Include="runtimes\**" Pack="true" PackagePath="runtimes\" Condition="Exists('runtimes\')" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StorjUplinkVersion</_Parameter1>
      <_Parameter2>$(StorjUplinkVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Reference the worker project so it is built before this library. -->
  <ItemGroup>
    <ProjectReference Include="..\uplink.NET.Worker\uplink.NET.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <!--
    Hook into GetCopyToOutputDirectoryItems so that the worker output files are
    propagated into ANY project that references uplink.NET (including the test project).
    The ProjectReference above guarantees the worker is already built by the time
    this target runs, so the Exists() conditions will be satisfied.

    The .dll is added directly to _SourceItemsToCopyToOutputDirectory rather than via
    Content/None items because MSBuild filters out .dll files that match a referenced
    project's assembly output when processing content items.  The json files do not
    trigger that filter so they can use None items.
  -->
  <Target Name="_AddWorkerFilesToContent" BeforeTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <!-- Direct injection into the output-copy list bypasses assembly-exclusion filter -->
      <_SourceItemsToCopyToOutputDirectory
          Include="$(MSBuildThisFileDirectory)..\uplink.NET.Worker\bin\$(Configuration)\net10.0\uplink.NET.Worker.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\uplink.NET.Worker\bin\$(Configuration)\net10.0\uplink.NET.Worker.dll')">
        <TargetPath>uplink.NET.Worker.dll</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_SourceItemsToCopyToOutputDirectory>
      <None Include="$(MSBuildThisFileDirectory)..\uplink.NET.Worker\bin\$(Configuration)\net10.0\uplink.NET.Worker.runtimeconfig.json"
            CopyToOutputDirectory="PreserveNewest"
            Pack="false"
            Link="uplink.NET.Worker.runtimeconfig.json"
            Condition="Exists('$(MSBuildThisFileDirectory)..\uplink.NET.Worker\bin\$(Configuration)\net10.0\uplink.NET.Worker.runtimeconfig.json')" />
      <None Include="$(MSBuildThisFileDirectory)..\uplink.NET.Worker\bin\$(Configuration)\net10.0\uplink.NET.Worker.deps.json"
            CopyToOutputDirectory="PreserveNewest"
            Pack="false"
            Link="uplink.NET.Worker.deps.json"
            Condition="Exists('$(MSBuildThisFileDirectory)..\uplink.NET.Worker\bin\$(Configuration)\net10.0\uplink.NET.Worker.deps.json')" />
    </ItemGroup>
  </Target>
</Project>
